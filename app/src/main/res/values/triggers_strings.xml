<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="trig_title">Notification rules</string>
    <string name="trig_info">When a notification matches a rule, the agent does the task you wrote. In "Ask" mode you get a notification with a Run button; "Auto" runs at once. Sending, paying and deleting still ask for confirmation. The notification text is treated as data, not as instructions.</string>
    <string name="trig_access">Notification access: %1$s</string>
    <string name="trig_access_btn">Grant notification access</string>
    <string name="trig_add">Add rule</string>
    <string name="trig_any_app">any app</string>
    <string name="trig_f_name">Name</string>
    <string name="trig_f_pkg">App package (empty = any), e.g. org.telegram.messenger</string>
    <string name="trig_f_contains">Words in the notification (separate with |, empty = any)</string>
    <string name="trig_f_goal">Task for the agent; may use {app} {title} {text}</string>
    <string name="trig_f_cooldown">Pause between runs, seconds</string>
    <string name="trig_save">Save</string>
    <string name="trig_delete">Delete</string>
    <string name="trig_run">Run</string>
    <string name="trig_offer">Run: %1$s?</string>
    <string name="trig_done">Done: %1$s</string>
    <string-array name="trig_modes">
        <item>Off</item>
        <item>Ask first</item>
        <item>Auto</item>
    </string-array>
</resources>
