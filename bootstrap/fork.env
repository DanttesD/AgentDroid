# Settings of our Termux fork. Sourced by configure-termux-packages.sh and the CI workflow.
AGENTDROID_PACKAGE_NAME=com.agentdroid
# Pinned upstream commit of termux/termux-packages used to build bootstrap and packages.
# Update deliberately (review upstream changes), not automatically.
TERMUX_PACKAGES_REF=02ff13ab090f09c14a5b8e07dc17b4b0eea69c1e
# Base URL where our apt repository is published (GitHub Pages of the project repo).
# Replace DanttesD/AgentDroid after the repository is created.
AGENTDROID_REPO_URL=https://danttesd.github.io/AgentDroid/apt
# Extra packages baked into the bootstrap (space separated): what the agent tools need on first start.
AGENTDROID_BOOTSTRAP_EXTRA="git openssh curl ripgrep proot"
